<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules: never back up YouTube cookies. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="secrets" />
        <exclude domain="file" path="secrets/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="secrets" />
        <exclude domain="file" path="secrets/" />
    </device-transfer>
</data-extraction-rules>
